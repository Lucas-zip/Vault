# ============================================
# Vault - Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e preencha com
# valores reais. NUNCA commite o .env real.
# ============================================

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vault
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Aplicação
PORT=8080

# JWT - Use uma chave secreta forte em produção
JWT_SECRET=COLOQUE_AQUI_UMA_CHAVE_SECRETA_FORTE_DE_PELO_MENOS_256_BITS
JWT_EXPIRATION=86400000
